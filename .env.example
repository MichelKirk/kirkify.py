# ==========================================
# KIRKIFY WEB AUTOMATION CONFIGURATION
# ==========================================

# --- Admin Authentication ---
ADMIN_EMAIL=admin@kirkify.local
ADMIN_PASSWORD=change_this_secret_password
SECRET_KEY=generate_a_random_32_character_secret_key_here

# --- Server Settings ---
PORT=8000
HOST=0.0.0.0

# --- Google Drive Sync ---
# The folder ID on Google Drive where all processed media will be uploaded
GDRIVE_FOLDER_ID=your_gdrive_folder_id_here
# Path to the Google Service Account JSON credentials file
GDRIVE_CREDENTIALS_FILE=/app/data/service_account.json

# --- Instagram Publisher ---
# Account credentials for automatic daily posting
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_SESSION_FILE=/app/data/ig_session.json

# --- Queue & Scheduling ---
# Daily time to publish 1 post from the queue (24h format HH:MM)
DAILY_PUBLISH_TIME=18:00
AUTO_PUBLISH_ENABLED=true
DEFAULT_CAPTION="Kirkified with love 🚀\n\n#kirkify #faceswap #reels #ai"

# --- Kirkify Processing Engine ---
USE_GPU=false
SCALE=1.0
MIN_FPS=60
ENHANCE_FACE=true
CRF=15
WORKERS=4

